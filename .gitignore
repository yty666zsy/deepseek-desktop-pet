# MusicFree 插件宿主的 npm 依赖（本机 npm install 生成，不进仓库；package-lock.json 保留以便复现）
musicfree/node_modules/

# 下载下来的第三方插件（GPL-3.0，来自 MusicFree 订阅，可由「➕ 订阅」一键重装，不入库）
musicfree/plugins/*.js
musicfree/plugins/_plugins.json
musicfree/plugins/_disabled/
musicfree/vars.json

# v6.85：一键下载落到这里的视频（本机媒体文件，不入库）
downloads/
_dl_test*/

# v6.86：Filee 便携版（159MB 的第三方转换引擎，本机解压，不入库）
tools/Filee/

# v6.92：本地声线库（8 个预训练模型 ≈1.2 GB，用 tools/fetch_voices.py 下载，不入库）
assets/voices/

# 对话存档（「新开对话」自动生成，含真实聊天内容，不入库）
chat_archive/
